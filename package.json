{
  "private": true,
  "scripts": {
    "check:release-hygiene": "node ./scripts/check-release-hygiene.mjs",
    "check:runtime": "node ./scripts/check-runtime.mjs",
    "check:backend-hardening": "node ./scripts/check-backend-hardening.mjs",
    "check:frontend-hardening": "node ./scripts/check-frontend-hardening.mjs",
    "check:frontend-flows": "node ./scripts/check-frontend-flows.mjs",
    "check:frontend-build-cache": "node ./scripts/check-frontend-build-cache.mjs",
    "check:data-recovery": "node ./scripts/check-data-recovery.mjs",
    "check:production-compose": "node ./scripts/check-production-compose.mjs",
    "check:production-env": "node ./scripts/check-production-env.mjs",
    "production:preflight": "node ./scripts/production-preflight.mjs",
    "production:rehearse": "node ./scripts/rehearse-production-compose.mjs",
    "backup:create": "node ./scripts/create-backup.mjs",
    "backup:verify": "node ./scripts/verify-backup.mjs",
    "backup:rehearse": "node ./scripts/rehearse-restore.mjs",
    "test:frontend-flows": "docker compose run --rm --no-deps -T --build frontend-flow-tests",
    "test:release-scripts": "node --test ./scripts/*.test.mjs",
