{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:container": "node ./scripts/start-container.mjs",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:release": "jest --config ./test/jest-e2e.json release-regression.e2e-spec.ts --runInBand",
    "audit:prod": "npm audit --omit=dev --audit-level=low",
    "audit:all": "npm audit --audit-level=high",
    "audit:report": "node ./scripts/report-backend-audit.mjs",
    "check:hardening": "node ../scripts/check-backend-hardening.mjs",
    "verify:release": "npm run check:hardening && npm run audit:prod && npm run audit:report && npm run test:release && npm run build",
    "seed": "ts-node prisma/seed.ts",
    "seed:temporary-movie-showings": "ts-node prisma/seed-temporary-movie-showings.ts",
    "test:xlsx-hardening": "jest payroll-xlsx-export.spec.ts --runInBand && node ./scripts/check-exceljs-streaming.mjs",
    "preflight:at3a": "ts-node scripts/at3a-preflight.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "11.1.28",
    "@prisma/client": "^6.19.3",
    "archiver": "file:vendor/archiver-compat",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "helmet": "^8.2.0",
    "multer": "2.2.0",
    "pdfkit": "^0.18.0",
    "react-easy-crop": "^5.5.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.4",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "2.2.0",
    "@types/node": "24.13.3",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "7.2.1",
    "@types/web-push": "^3.6.4",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.7.0",
    "jest": "30.4.2",
    "prettier": "3.9.6",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-loader": "9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.1"
  },
  "overrides": {
    "exceljs": {
      "archiver": "$archiver",
      "unzipper": "0.12.3",
      "uuid": "11.1.1"
    },
    "readdir-glob": {
      "minimatch": "10.2.6",
      "brace-expansion": "5.0.9"
    },
    "body-parser": "2.3.0",
    "multer": "2.2.0",
    "qs": "6.15.3",
    "tmp": "0.2.7",
    "ws": "8.21.1",
    "brace-expansion": "5.0.9"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^archiver$": "<rootDir>/../test-support/archiver-jest-shim.cjs"
    }
  }
}
