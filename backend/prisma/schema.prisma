generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER
  ADMIN
  EMPLOYEE
}

enum EmploymentType {
  HOURLY
  SALARIED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ShiftTradeStatus {
  OPEN
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ShiftTradeType {
  POOL
  DIRECT
}

enum TimeEntryStatus {
  PENDING
  NEEDS_CHANGES
  APPROVED
  VOIDED
}

enum PayrollPeriodStatus {
  OPEN
  LOCKED
  EXPORTED
  UNLOCKED
}

enum PayrollPeriodModel {
  CALENDAR_MONTH
  FIXED_DAY_TO_DAY
  BIWEEKLY
}

enum PayrollPayoutRule {
  LAST_WEEKDAY_OF_MONTH
  FIXED_DAY_OF_MONTH
}

enum PayrollAdjustmentType {
  APPROVAL_AFTER_EXPORT
  EDIT_AFTER_EXPORT
  MANUAL_ENTRY_IN_EXPORTED_PERIOD
}

enum PayrollAdjustmentStatus {
  PENDING
  INCLUDED
  VOIDED
}

enum PayrollAdjustmentExportCategory {
  HOURLY
  SALARIED
  VOLUNTEER
}

enum PayrollAdjustmentRevisionAction {
  CREATED
  UPDATED
  INCLUDED
  VOIDED
}

enum JobFunctionTimingAnchor {
  DAY_PERIOD_START
  DAY_PERIOD_END
  FIRST_MOVIE_START
  FIRST_MOVIE_END
  LAST_MOVIE_START
  LAST_MOVIE_END
  FIXED_TIME
  FIRST_MOVIE_ENDLAST_MOVIE_END
}

enum ScheduleTemplateWeekParity {
  ANY
  EVEN
  ODD
}

model Cinema {
  id                                Int                           @id @default(autoincrement())
  name                              String
  logoUrl                           String?
  createdAt                         DateTime                      @default(now())
  allowShiftTradePool               Boolean                       @default(false)
  allowShiftTradeDirect             Boolean                       @default(false)
  payrollRulesEnabled               Boolean                       @default(false)
  clockInDeviationToleranceMinutes  Int                           @default(0)
  clockOutDeviationToleranceMinutes Int                           @default(0)
  requireNoteForClockInDeviation    Boolean                       @default(true)
  requireNoteForClockOutDeviation   Boolean                       @default(true)
  requireNoteForManualEntry         Boolean                       @default(true)
  payrollOvertimeEnabled            Boolean                       @default(false)
  plannedOvertimeEnabled            Boolean                       @default(true)
  dailyOvertimeEnabled              Boolean                       @default(false)
  weeklyOvertimeEnabled             Boolean                       @default(false)
  dailyOvertimeThreshold            Float                         @default(8)
  weeklyOvertimeThreshold           Float                         @default(37)
  payrollPeriodModel                PayrollPeriodModel            @default(CALENDAR_MONTH)
  payrollPeriodStartDay             Int                           @default(1)
  payrollPeriodEndDay               Int                           @default(31)
  payrollPeriodAnchorDate           DateTime?
  payrollPayoutRule                 PayrollPayoutRule             @default(LAST_WEEKDAY_OF_MONTH)
  payrollPayoutDay                  Int                           @default(0)
  movieShowings                     MovieShowing[]
  leaveRequests                     LeaveRequest[]
  shiftTrades                       ShiftTrade[]
  users                             User[]                @relation("UserPrimaryCinema")
  defaultCinemaUsers                User[]                @relation("UserDefaultCinema")
  userCinemaMemberships             UserCinemaMembership[]
  workTypes                         WorkType[]
  dayPeriods                        DayPeriod[]
  jobFunctions                      JobFunction[]
  jobFunctionTimingRules            JobFunctionTimingRule[]
  scheduleTemplates                 ScheduleTemplate[]
  monthPlanDays                     MonthPlanDay[]
  scheduleTemplateDays              ScheduleTemplateDay[]
  scheduleTemplateJobFunctions      ScheduleTemplateJobFunction[]
  scheduleTemplateAssignments       ScheduleTemplateAssignment[]
  userJobFunctions                  UserJobFunction[]
  shifts                            Shift[]
  messages                          Message[]
  timeEntries                       TimeEntry[]
  notifications                     Notification[]
  pushSubscriptions                 PushSubscription[]
  employeeDocuments                 EmployeeDocument[]
  auditLogs                         AuditLog[]
  payrollPeriods                    PayrollPeriod[]
  payrollTypes                      PayrollType[]
  aiLearningEvents                  AiLearningEvent[]
  staffingRequests                  StaffingRequest[]
  payrollAdjustments                PayrollAdjustment[]
  aiEnabled                         Boolean                       @default(false)
  shiftPlanningDrafts               ShiftPlanningDraft[]
  shiftPlanningDraftItems           ShiftPlanningDraftItem[]
  moduleSettings                   CinemaModuleSetting[]
}


model CinemaModuleSetting {
  id        Int      @id @default(autoincrement())
  cinemaId  Int
  cinema    Cinema   @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  moduleKey String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cinemaId, moduleKey])
  @@index([cinemaId, enabled])
}

model User {
  timeEntryRevisions          TimeEntryRevision[]
  id                          Int                          @id @default(autoincrement())
  email                       String                       @unique
  password                    String
  firstName                   String
  lastName                    String
  phone                       String?
  profileImage                String?
  address                     String?
  birthDate                   DateTime?
  emergencyPhone              String?
  hireDate                    DateTime?
  skills                      String?
  notes                       String?
  theme                       String                       @default("light")
  role                        Role                         @default(EMPLOYEE)
  createdAt                   DateTime                     @default(now())
  isActive                    Boolean                      @default(true)
  deactivatedAt               DateTime?
  employeeNumber              String?
  payrollEmployeeId           String?
  employmentType              EmploymentType               @default(HOURLY)
  canManageSchedule           Boolean                      @default(false)
  canManageUsers              Boolean                      @default(false)
  canManagePayroll            Boolean                      @default(false)
  canManageLeaveRequests      Boolean                      @default(false)
  canManageCinemaSettings     Boolean                      @default(false)
  canSendBroadcastMessages    Boolean                      @default(false)
  cinemaId                    Int?
  cinema                      Cinema?                      @relation("UserPrimaryCinema", fields: [cinemaId], references: [id])
  defaultCinemaId             Int?
  defaultCinema               Cinema?                      @relation("UserDefaultCinema", fields: [defaultCinemaId], references: [id], onDelete: SetNull)
  cinemaMemberships           UserCinemaMembership[]
  shifts                      Shift[]
  leaveRequests               LeaveRequest[]
  createdLeaveRequests        LeaveRequest[]               @relation("LeaveRequestCreatedBy")
  userJobFunctions            UserJobFunction[]            @relation("UserJobFunctionUser")
  assignedUserJobFunctions    UserJobFunction[]            @relation("UserJobFunctionAssignedBy")
  scheduleTemplateAssignments ScheduleTemplateAssignment[]
  offeredTrades               ShiftTrade[]                 @relation("OfferedTrades")
  acceptedTrades              ShiftTrade[]                 @relation("AcceptedTrades")
  rejectedTrades              ShiftTrade[]                 @relation("RejectedTrades")
  targetedTrades              ShiftTrade[]                 @relation("TargetedTrades")
  sentMessages                Message[]                    @relation("SentMessages")
  receivedMessages            Message[]                    @relation("ReceivedMessages")
  timeEntries                 TimeEntry[]
  pushSubscriptions           PushSubscription[]
  documents                   EmployeeDocument[]
  notifications               Notification[]
  auditLogs                   AuditLog[]
  requestedStaffingRequests   StaffingRequest[]            @relation("RequestedStaffingRequests")
  targetedStaffingRequests    StaffingRequest[]            @relation("TargetedStaffingRequests")
  payrollAdjustments          PayrollAdjustment[]          @relation("PayrollAdjustmentUser")
  createdPayrollAdjustments   PayrollAdjustment[]          @relation("PayrollAdjustmentCreatedBy")
  payrollAdjustmentRevisions  PayrollAdjustmentRevision[]
  staffingAiProfile           StaffingAiProfile?
  createdShiftPlanningDrafts  ShiftPlanningDraft[]         @relation("ShiftPlanningDraftCreatedBy")
  shiftPlanningDraftItems     ShiftPlanningDraftItem[]

  @@index([defaultCinemaId])
}


model UserCinemaMembership {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cinemaId  Int
  cinema    Cinema   @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, cinemaId])
  @@index([userId])
  @@index([cinemaId])
  @@index([isActive])
}

model WorkType {
  id               Int               @id @default(autoincrement())
  name             String
  color            String            @default("#2563eb")
  createdAt        DateTime          @default(now())
  isActive         Boolean           @default(true)
  archivedAt       DateTime?
  cinemaId         Int
  cinema           Cinema            @relation(fields: [cinemaId], references: [id])
  payrollTypeId    Int?
  payrollType      PayrollType?      @relation(fields: [payrollTypeId], references: [id])
  shifts           Shift[]
  staffingRequests StaffingRequest[]
  jobFunctions     JobFunction[]
}

model DayPeriod {
  id           Int           @id @default(autoincrement())
  cinemaId     Int
  cinema       Cinema        @relation(fields: [cinemaId], references: [id])
  name         String
  startMinute  Int
  endMinute    Int
  sortOrder    Int           @default(0)
  isActive     Boolean       @default(true)
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  jobFunctions JobFunction[]

  @@index([cinemaId])
  @@index([isActive])
  @@index([startMinute, endMinute])
}

model JobFunction {
  id          Int        @id @default(autoincrement())
  cinemaId    Int
  cinema      Cinema     @relation(fields: [cinemaId], references: [id])
  name        String
  description String?
  color       String     @default("#2563eb")
  sortOrder   Int        @default(0)
  dayPeriodId Int?
  dayPeriod   DayPeriod? @relation(fields: [dayPeriodId], references: [id])
  workTypeId  Int?
  workType    WorkType?  @relation(fields: [workTypeId], references: [id], onDelete: SetNull)
  isActive    Boolean    @default(true)
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  userJobFunctions             UserJobFunction[]
  timingRule                   JobFunctionTimingRule?
  scheduleTemplateJobFunctions ScheduleTemplateJobFunction[]
  shiftPlanningDraftItems      ShiftPlanningDraftItem[]

  @@index([cinemaId])
  @@index([dayPeriodId])
  @@index([workTypeId])
  @@index([isActive])
}

model JobFunctionTimingRule {
  id            Int         @id @default(autoincrement())
  cinemaId      Int
  cinema        Cinema      @relation(fields: [cinemaId], references: [id])
  jobFunctionId Int         @unique
  jobFunction   JobFunction @relation(fields: [jobFunctionId], references: [id], onDelete: Cascade)

  startAnchor        JobFunctionTimingAnchor @default(DAY_PERIOD_START)
  startOffsetMinutes Int                     @default(0)
  startFixedMinute   Int?

  endAnchor        JobFunctionTimingAnchor @default(DAY_PERIOD_END)
  endOffsetMinutes Int                     @default(0)
  endFixedMinute   Int?

  fallbackStartMinute Int?
  fallbackEndMinute   Int?
  clampToDayPeriod    Boolean @default(true)
  isActive            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([cinemaId])
  @@index([jobFunctionId])
  @@index([isActive])
}

model UserJobFunction {
  id               Int         @id @default(autoincrement())
  cinemaId         Int
  cinema           Cinema      @relation(fields: [cinemaId], references: [id])
  userId           Int
  user             User        @relation("UserJobFunctionUser", fields: [userId], references: [id])
  jobFunctionId    Int
  jobFunction      JobFunction @relation(fields: [jobFunctionId], references: [id])
  assignedByUserId Int?
  assignedByUser   User?       @relation("UserJobFunctionAssignedBy", fields: [assignedByUserId], references: [id])
  createdAt        DateTime    @default(now())

  @@unique([userId, jobFunctionId])
  @@index([cinemaId])
  @@index([userId])
  @@index([jobFunctionId])
}

model ScheduleTemplate {
  id          Int                        @id @default(autoincrement())
  cinemaId    Int
  cinema      Cinema                     @relation(fields: [cinemaId], references: [id])
  name        String
  description String?
  weekParity  ScheduleTemplateWeekParity @default(ANY)
  startsOn    DateTime?
  sortOrder   Int                        @default(0)
  isActive    Boolean                    @default(true)
  archivedAt  DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @default(now()) @updatedAt

  days                    ScheduleTemplateDay[]
  monthPlanDays           MonthPlanDay[]
  shiftPlanningDrafts     ShiftPlanningDraft[]
  shiftPlanningDraftItems ShiftPlanningDraftItem[]

  @@index([cinemaId])
  @@index([isActive])
  @@index([weekParity])
}

model MonthPlanDay {
  id                      Int                      @id @default(autoincrement())
  cinemaId                Int
  cinema                  Cinema                   @relation(fields: [cinemaId], references: [id])
  date                    DateTime
  isActive                Boolean                  @default(true)
  scheduleTemplateId      Int?
  scheduleTemplate        ScheduleTemplate?        @relation(fields: [scheduleTemplateId], references: [id], onDelete: SetNull)
  note                    String?
  movieProgramFirstStart  DateTime?
  movieProgramLastEnd     DateTime?
  movieShowingCount       Int                      @default(0)
  plannedShiftCount       Int                      @default(0)
  unassignedShiftCount    Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @default(now()) @updatedAt
  shiftPlanningDraftItems ShiftPlanningDraftItem[]

  @@unique([cinemaId, date])
  @@index([cinemaId])
  @@index([date])
  @@index([scheduleTemplateId])
  @@index([isActive])
}

model ScheduleTemplateDay {
  id         Int              @id @default(autoincrement())
  cinemaId   Int
  cinema     Cinema           @relation(fields: [cinemaId], references: [id])
  templateId Int
  template   ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  weekday    Int
  isActive   Boolean          @default(true)
  note       String?
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt

  jobFunctions            ScheduleTemplateJobFunction[]
  shiftPlanningDraftItems ShiftPlanningDraftItem[]

  @@unique([templateId, weekday])
  @@index([cinemaId])
  @@index([templateId])
  @@index([weekday])
  @@index([isActive])
}

model ScheduleTemplateJobFunction {
  id            Int                 @id @default(autoincrement())
  cinemaId      Int
  cinema        Cinema              @relation(fields: [cinemaId], references: [id])
  templateDayId Int
  templateDay   ScheduleTemplateDay @relation(fields: [templateDayId], references: [id], onDelete: Cascade)
  jobFunctionId Int
  jobFunction   JobFunction         @relation(fields: [jobFunctionId], references: [id])
  requiredCount Int                 @default(1)
  sortOrder     Int                 @default(0)
  note          String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt

  assignments             ScheduleTemplateAssignment[]
  shiftPlanningDraftItems ShiftPlanningDraftItem[]

  @@index([cinemaId])
  @@index([templateDayId])
  @@index([jobFunctionId])
}

model ScheduleTemplateAssignment {
  id                    Int                         @id @default(autoincrement())
  cinemaId              Int
  cinema                Cinema                      @relation(fields: [cinemaId], references: [id])
  templateJobFunctionId Int
  templateJobFunction   ScheduleTemplateJobFunction @relation(fields: [templateJobFunctionId], references: [id], onDelete: Cascade)
  userId                Int
  user                  User                        @relation(fields: [userId], references: [id])
  sortOrder             Int                         @default(0)
  createdAt             DateTime                    @default(now())

  @@unique([templateJobFunctionId, userId])
  @@index([cinemaId])
  @@index([templateJobFunctionId])
  @@index([userId])
}

model ShiftPlanningDraft {
  id                 Int                      @id @default(autoincrement())
  cinemaId           Int
  cinema             Cinema                   @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  year               Int
  month              Int
  status             String                   @default("DRAFT")
  source             String                   @default("MONTH_PLAN")
  note               String?
  warnings           Json?
  createdByUserId    Int?
  createdByUser      User?                    @relation("ShiftPlanningDraftCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @default(now()) @updatedAt
  items              ShiftPlanningDraftItem[]
  scheduleTemplate   ScheduleTemplate?        @relation(fields: [scheduleTemplateId], references: [id])
  scheduleTemplateId Int?

  @@index([cinemaId])
  @@index([year, month])
  @@index([status])
  @@index([createdAt])
}

model ShiftPlanningDraftItem {
  id                    Int                          @id @default(autoincrement())
  cinemaId              Int
  cinema                Cinema                       @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  draftId               Int
  draft                 ShiftPlanningDraft           @relation(fields: [draftId], references: [id], onDelete: Cascade)
  date                  DateTime
  monthPlanDayId        Int?
  monthPlanDay          MonthPlanDay?                @relation(fields: [monthPlanDayId], references: [id], onDelete: SetNull)
  scheduleTemplateId    Int?
  scheduleTemplate      ScheduleTemplate?            @relation(fields: [scheduleTemplateId], references: [id], onDelete: SetNull)
  scheduleTemplateDayId Int?
  scheduleTemplateDay   ScheduleTemplateDay?         @relation(fields: [scheduleTemplateDayId], references: [id], onDelete: SetNull)
  templateJobFunctionId Int?
  templateJobFunction   ScheduleTemplateJobFunction? @relation(fields: [templateJobFunctionId], references: [id], onDelete: SetNull)
  jobFunctionId         Int?
  jobFunction           JobFunction?                 @relation(fields: [jobFunctionId], references: [id], onDelete: SetNull)
  userId                Int?
  user                  User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  requiredIndex         Int                          @default(1)
  status                String                       @default("DRAFT")
  plannedStartMinute    Int?
  plannedEndMinute      Int?
  startTime             DateTime?
  endTime               DateTime?
  warningCode           String?
  warningMessage        String?
  metadata              Json?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @default(now()) @updatedAt

  @@index([cinemaId])
  @@index([draftId])
  @@index([date])
  @@index([monthPlanDayId])
  @@index([scheduleTemplateId])
  @@index([scheduleTemplateDayId])
  @@index([templateJobFunctionId])
  @@index([jobFunctionId])
  @@index([userId])
  @@index([status])
}

model Shift {
  id               Int               @id @default(autoincrement())
  startTime        DateTime
  endTime          DateTime
  note             String?
  createdAt        DateTime          @default(now())
  cinemaId         Int
  cinema           Cinema            @relation(fields: [cinemaId], references: [id])
  userId           Int?
  user             User?             @relation(fields: [userId], references: [id])
  workTypeId       Int
  workType         WorkType          @relation(fields: [workTypeId], references: [id])
  trades           ShiftTrade[]
  timeEntries      TimeEntry[]
  staffingRequests StaffingRequest[]
}

model MovieShowing {
  id        Int      @id @default(autoincrement())
  title     String
  hall      String
  startTime DateTime
  endTime   DateTime
  soldSeats Int      @default(0)
  freeSeats Int      @default(0)
  createdAt DateTime @default(now())
  cinemaId  Int
  cinema    Cinema   @relation(fields: [cinemaId], references: [id])
}

model LeaveRequest {
  id              Int         @id @default(autoincrement())
  startDate       DateTime
  endDate         DateTime
  reason          String?
  status          LeaveStatus @default(PENDING)
  createdAt       DateTime    @default(now())
  cinemaId        Int
  cinema          Cinema      @relation(fields: [cinemaId], references: [id])
  userId          Int
  user            User        @relation(fields: [userId], references: [id])
  createdByUserId Int
  createdByUser   User        @relation("LeaveRequestCreatedBy", fields: [createdByUserId], references: [id])
}

model ShiftTrade {
  id               Int              @id @default(autoincrement())
  status           ShiftTradeStatus @default(OPEN)
  message          String?
  createdAt        DateTime         @default(now())
  shiftId          Int
  shift            Shift            @relation(fields: [shiftId], references: [id])
  offeredByUserId  Int
  offeredByUser    User             @relation("OfferedTrades", fields: [offeredByUserId], references: [id])
  acceptedByUserId Int?
  acceptedByUser   User?            @relation("AcceptedTrades", fields: [acceptedByUserId], references: [id])
  rejectedByUserId Int?
  rejectedByUser   User?            @relation("RejectedTrades", fields: [rejectedByUserId], references: [id])
  targetUserId     Int?
  targetUser       User?            @relation("TargetedTrades", fields: [targetUserId], references: [id])
  cinemaId         Int
  cinema           Cinema           @relation(fields: [cinemaId], references: [id])
  type             ShiftTradeType   @default(POOL)
}

model Message {
  id                  Int       @id @default(autoincrement())
  subject             String
  body                String
  createdAt           DateTime  @default(now())
  readAt              DateTime?
  cinemaId            Int
  cinema              Cinema    @relation(fields: [cinemaId], references: [id])
  senderId            Int
  sender              User      @relation("SentMessages", fields: [senderId], references: [id])
  receiverId          Int?
  receiver            User?     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  isBroadcast         Boolean   @default(false)
  isRead              Boolean   @default(false)
  archivedAt          DateTime?
  recalledAt          DateTime?
  recalledByUserId    Int?
  systemType          String?
  relatedShiftTradeId Int?
}

model TimeEntry {
  revisions                 TimeEntryRevision[]
  id                        Int                 @id @default(autoincrement())
  clockIn                   DateTime
  clockOut                  DateTime?
  createdAt                 DateTime            @default(now())
  status                    TimeEntryStatus     @default(PENDING)
  note                      String?
  clockInNote               String?
  clockOutNote              String?
  adminNote                 String?
  userId                    Int
  user                      User                @relation(fields: [userId], references: [id])
  shiftId                   Int?
  shift                     Shift?              @relation(fields: [shiftId], references: [id])
  cinemaId                  Int
  cinema                    Cinema              @relation(fields: [cinemaId], references: [id])
  payrollPeriodId           Int?
  payrollPeriod             PayrollPeriod?      @relation(fields: [payrollPeriodId], references: [id])
  payrollLocked             Boolean             @default(false)
  payrollUnlockedByMaster   Boolean             @default(false)
  payrollUnlockedAt         DateTime?
  payrollLockNote           String?
  isPayrollAdjustment       Boolean             @default(false)
  originalPayrollPeriodId   Int?
  originalPayrollPeriod     PayrollPeriod?      @relation("OriginalPayrollPeriod", fields: [originalPayrollPeriodId], references: [id])
  adjustmentPayrollPeriodId Int?
  adjustmentPayrollPeriod   PayrollPeriod?      @relation("AdjustmentPayrollPeriod", fields: [adjustmentPayrollPeriodId], references: [id])
  payrollAdjustmentReason   String?
  payrollTypeId             Int?
  payrollType               PayrollType?        @relation(fields: [payrollTypeId], references: [id])
  payrollAdjustments        PayrollAdjustment[]
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  cinemaId  Int
  cinema    Cinema   @relation(fields: [cinemaId], references: [id])
}

model EmployeeDocument {
  id        Int      @id @default(autoincrement())
  title     String
  fileUrl   String
  fileName  String
  fileType  String?
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  cinemaId  Int
  cinema    Cinema   @relation(fields: [cinemaId], references: [id])

  @@index([cinemaId, userId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  cinemaId  Int
  cinema    Cinema   @relation(fields: [cinemaId], references: [id])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  entityType  String
  entityId    Int?
  description String?
  createdAt   DateTime @default(now())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  cinemaId    Int?
  cinema      Cinema?  @relation(fields: [cinemaId], references: [id])
}

model PayrollPeriod {
  id                           Int                 @id @default(autoincrement())
  cinemaId                     Int
  cinema                       Cinema              @relation(fields: [cinemaId], references: [id])
  startDate                    DateTime
  endDate                      DateTime
  status                       PayrollPeriodStatus @default(OPEN)
  lockedAt                     DateTime?
  lockedByUserId               Int?
  exportedAt                   DateTime?
  exportedByUserId             Int?
  originalAdjustmentEntries    TimeEntry[]         @relation("OriginalPayrollPeriod")
  adjustmentEntries            TimeEntry[]         @relation("AdjustmentPayrollPeriod")
  originalPayrollAdjustments   PayrollAdjustment[] @relation("OriginalPayrollAdjustments")
  settlementPayrollAdjustments PayrollAdjustment[] @relation("SettlementPayrollAdjustments")
  unlockedAt                   DateTime?
  unlockedByUserId             Int?
  unlockNote                   String?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  timeEntries                  TimeEntry[]

  @@unique([cinemaId, startDate, endDate])
  @@index([cinemaId])
  @@index([startDate, endDate])
  @@index([status])
}

model PayrollType {
  id                 Int                 @id @default(autoincrement())
  cinemaId           Int
  cinema             Cinema              @relation(fields: [cinemaId], references: [id])
  name               String
  payrollCode        String
  exportCode         String?
  description        String?
  isDefault          Boolean             @default(false)
  isActive           Boolean             @default(true)
  color              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  workTypes          WorkType[]
  timeEntries        TimeEntry[]
  payrollAdjustments PayrollAdjustment[]

  @@index([cinemaId])
  @@index([payrollCode])
}

model PayrollAdjustment {
  id                        Int                             @id @default(autoincrement())
  cinemaId                  Int
  cinema                    Cinema                          @relation(fields: [cinemaId], references: [id])
  userId                    Int
  user                      User                            @relation("PayrollAdjustmentUser", fields: [userId], references: [id])
  timeEntryId               Int
  timeEntry                 TimeEntry                       @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  originalPayrollPeriodId   Int
  originalPayrollPeriod     PayrollPeriod                   @relation("OriginalPayrollAdjustments", fields: [originalPayrollPeriodId], references: [id])
  settlementPayrollPeriodId Int?
  settlementPayrollPeriod   PayrollPeriod?                  @relation("SettlementPayrollAdjustments", fields: [settlementPayrollPeriodId], references: [id])
  payrollTypeId             Int?
  payrollType               PayrollType?                    @relation(fields: [payrollTypeId], references: [id])
  type                      PayrollAdjustmentType
  status                    PayrollAdjustmentStatus         @default(PENDING)
  exportCategory            PayrollAdjustmentExportCategory @default(HOURLY)
  minutesDelta              Int
  exportedMinutes           Int
  adjustedMinutes           Int
  previousMinutes           Int?
  newMinutes                Int?
  previousClockIn           DateTime?
  previousClockOut          DateTime?
  newClockIn                DateTime?
  newClockOut               DateTime?
  reason                    String
  createdByUserId           Int?
  createdByUser             User?                           @relation("PayrollAdjustmentCreatedBy", fields: [createdByUserId], references: [id])
  revisions                 PayrollAdjustmentRevision[]
  includedAt                DateTime?
  voidedAt                  DateTime?
  metadata                  Json?
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt

  @@index([cinemaId])
  @@index([userId])
  @@index([timeEntryId])
  @@index([originalPayrollPeriodId])
  @@index([settlementPayrollPeriodId])
  @@index([payrollTypeId])
  @@index([status])
  @@index([type])
  @@index([exportCategory])
}

model PayrollAdjustmentRevision {
  id                                Int                             @id @default(autoincrement())
  payrollAdjustmentId               Int
  payrollAdjustment                 PayrollAdjustment               @relation(fields: [payrollAdjustmentId], references: [id], onDelete: Cascade)
  changedByUserId                   Int?
  changedByUser                     User?                           @relation(fields: [changedByUserId], references: [id])
  action                            PayrollAdjustmentRevisionAction
  previousStatus                    PayrollAdjustmentStatus?
  newStatus                         PayrollAdjustmentStatus?
  previousExportedMinutes           Int?
  newExportedMinutes                Int?
  previousAdjustedMinutes           Int?
  newAdjustedMinutes                Int?
  previousMinutesDelta              Int?
  newMinutesDelta                   Int?
  previousOriginalPayrollPeriodId   Int?
  newOriginalPayrollPeriodId        Int?
  previousSettlementPayrollPeriodId Int?
  newSettlementPayrollPeriodId      Int?
  reason                            String?
  createdAt                         DateTime                        @default(now())

  @@index([payrollAdjustmentId])
  @@index([changedByUserId])
  @@index([createdAt])
}

model AiLearningEvent {
  id        Int      @id @default(autoincrement())
  cinemaId  Int
  cinema    Cinema   @relation(fields: [cinemaId], references: [id])
  type      String
  severity  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([cinemaId])
  @@index([type])
  @@index([createdAt])
}

enum StaffingRequestType {
  EXTRA_SHIFT
  EMERGENCY
  REPLACEMENT
  OVERTIME
}

enum StaffingRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model StaffingRequest {
  id                Int                   @id @default(autoincrement())
  cinemaId          Int
  cinema            Cinema                @relation(fields: [cinemaId], references: [id])
  shiftId           Int?
  shift             Shift?                @relation(fields: [shiftId], references: [id])
  requestStartTime  DateTime?
  requestEndTime    DateTime?
  workTypeId        Int?
  workType          WorkType?             @relation(fields: [workTypeId], references: [id])
  requestedByUserId Int
  requestedByUser   User                  @relation("RequestedStaffingRequests", fields: [requestedByUserId], references: [id])
  targetUserId      Int?
  targetUser        User?                 @relation("TargetedStaffingRequests", fields: [targetUserId], references: [id])
  type              StaffingRequestType
  status            StaffingRequestStatus @default(PENDING)
  priority          Int                   @default(1)
  message           String?
  aiGenerated       Boolean               @default(false)
  expiresAt         DateTime?
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([cinemaId])
  @@index([shiftId])
  @@index([workTypeId])
  @@index([requestStartTime])
  @@index([requestedByUserId])
  @@index([targetUserId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model StaffingAiProfile {
  id                      Int       @id @default(autoincrement())
  userId                  Int       @unique
  user                    User      @relation(fields: [userId], references: [id])
  acceptanceRate          Float     @default(0)
  rejectionRate           Float     @default(0)
  emergencyAcceptanceRate Float     @default(0)
  fatigueScore            Float     @default(0)
  overtimeScore           Float     @default(0)
  aiPriorityScore         Float     @default(0)
  preferredHours          String?
  preferredWorkTypes      String?
  totalRequests           Int       @default(0)
  acceptedRequests        Int       @default(0)
  rejectedRequests        Int       @default(0)
  lastAcceptedAt          DateTime?
  lastRejectedAt          DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([aiPriorityScore])
  @@index([fatigueScore])
  @@index([overtimeScore])
}

model TimeEntryRevision {
  id                   Int              @id @default(autoincrement())
  timeEntryId          Int
  timeEntry            TimeEntry        @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  changedByUserId      Int?
  changedByUser        User?            @relation(fields: [changedByUserId], references: [id])
  action               String
  previousStatus       TimeEntryStatus?
  newStatus            TimeEntryStatus?
  previousClockIn      DateTime?
  newClockIn           DateTime?
  previousClockOut     DateTime?
  newClockOut          DateTime?
  previousNote         String?
  newNote              String?
  previousClockInNote  String?
  newClockInNote       String?
  previousClockOutNote String?
  newClockOutNote      String?
  previousAdminNote    String?
  newAdminNote         String?
  reason               String?
  createdAt            DateTime         @default(now())

  @@index([timeEntryId])
  @@index([changedByUserId])
  @@index([createdAt])
}

model SystemErrorLog {
  id               Int       @id @default(autoincrement())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())
  severity         String    @default("ERROR")
  status           String    @default("NEW")
  source           String    @default("backend")
  method           String?
  path             String?
  action           String?
  message          String
  technicalMessage String?
  stack            String?
  correlationId    String?
  statusCode       Int?
  userId           Int?
  userRole         String?
  cinemaId         Int?
  metadata         Json?
  resolvedAt       DateTime?
  resolvedByUserId Int?
  resolutionNote   String?

  @@index([createdAt])
  @@index([severity])
  @@index([status])
  @@index([cinemaId])
  @@index([userId])
  @@index([correlationId])
}
