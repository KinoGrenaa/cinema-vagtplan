  @@index([shiftId])
  @@index([workTypeId])
  @@index([jobFunctionId])
  @@index([requestStartTime])
  @@index([requestedByUserId])
  @@index([targetUserId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
