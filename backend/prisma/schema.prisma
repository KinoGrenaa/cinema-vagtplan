  timeEntry                    TimeEntry                       @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  originalPayrollPeriodId      Int
  originalPayrollPeriod        PayrollPeriod                   @relation("OriginalPayrollAdjustments", fields: [originalPayrollPeriodId], references: [id])
  settlementPayrollPeriodId    Int?
  settlementPayrollPeriod      PayrollPeriod?                  @relation("SettlementPayrollAdjustments", fields: [settlementPayrollPeriodId], references: [id])
  payrollTypeId                Int?
  payrollType                  PayrollType?                    @relation(fields: [payrollTypeId], references: [id])
  type                         PayrollAdjustmentType
  status                       PayrollAdjustmentStatus         @default(PENDING)
  exportCategory               PayrollAdjustmentExportCategory @default(HOURLY)
  minutesDelta                 Int
  exportedMinutes              Int
  adjustedMinutes              Int
  amountDelta                  Decimal?                        @db.Decimal(14, 2)
  exportedAmount               Decimal?                        @db.Decimal(14, 2)
  adjustedAmount               Decimal?                        @db.Decimal(14, 2)
  currencyCode                 String                          @default("DKK")
  previousMinutes              Int?
  newMinutes                   Int?
  previousClockIn              DateTime?
  previousClockOut             DateTime?
  newClockIn                   DateTime?
  newClockOut                  DateTime?
  sourceCalculationRunId       Int?
  sourceCalculationRun         PayrollCalculationRun?          @relation(fields: [sourceCalculationRunId], references: [id], onDelete: Restrict)
  sourceCalculationLineId      Int?
  sourceCalculationLine        PayrollCalculationLine?         @relation("PayrollAdjustmentSourceCalculationLine", fields: [sourceCalculationLineId], references: [id], onDelete: Restrict)
  sourcePayRateVersionId       Int?
  sourcePayRateVersion         MembershipPayRateVersion?        @relation(fields: [sourcePayRateVersionId], references: [id], onDelete: Restrict)
  sourcePayRuleVersionId       Int?
  sourcePayRuleVersion         PayRuleVersion?                  @relation(fields: [sourcePayRuleVersionId], references: [id], onDelete: Restrict)
  payrollConfigurationChangeId Int?
  payrollConfigurationChange   PayrollConfigurationChange?      @relation(fields: [payrollConfigurationChangeId], references: [id], onDelete: Restrict)
  reason                       String
  createdByUserId              Int?
  createdByUser                User?                           @relation("PayrollAdjustmentCreatedBy", fields: [createdByUserId], references: [id])
  revisions                    PayrollAdjustmentRevision[]
  calculationLines             PayrollCalculationLine[]
  includedAt                   DateTime?
  voidedAt                     DateTime?
  metadata                     Json?
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt

  @@index([cinemaId])
  @@index([userId])
  @@index([timeEntryId])
  @@index([originalPayrollPeriodId])
  @@index([settlementPayrollPeriodId])
  @@index([payrollTypeId])
  @@index([sourceCalculationRunId])
  @@index([sourceCalculationLineId])
  @@index([sourcePayRateVersionId])
  @@index([sourcePayRuleVersionId])
  @@index([payrollConfigurationChangeId])
  @@unique([payrollConfigurationChangeId, timeEntryId])
  @@index([status])
  @@index([type])
  @@index([exportCategory])
}


