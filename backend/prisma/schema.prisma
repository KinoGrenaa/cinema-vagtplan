generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER
  ADMIN
  EMPLOYEE
}

enum CinemaRole {
  ADMIN
  EMPLOYEE
}

enum EmploymentType {
  HOURLY
  SALARIED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum ShiftTradeStatus {
  OPEN
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ShiftTradeType {
  POOL
  DIRECT
}

enum TimeEntryStatus {
  PENDING
  NEEDS_CHANGES
  APPROVED
  VOIDED
}

enum PayrollPeriodStatus {
  OPEN
  LOCKED
  EXPORTED
  UNLOCKED
}

enum PayrollPeriodModel {
  CALENDAR_MONTH
  FIXED_DAY_TO_DAY
  BIWEEKLY
}

enum PayrollPayoutRule {
  LAST_WEEKDAY_OF_MONTH
  FIXED_DAY_OF_MONTH
}

enum PayrollAdjustmentType {
  APPROVAL_AFTER_EXPORT
  EDIT_AFTER_EXPORT
  MANUAL_ENTRY_IN_EXPORTED_PERIOD
  PAY_RATE_CHANGE
  PAY_RULE_CHANGE
  PAYROLL_MODE_CHANGE
  MANUAL_MONEY_ADJUSTMENT
}


enum PayrollAdjustmentStatus {
  PENDING
  INCLUDED
  VOIDED
}

enum PayrollAdjustmentExportCategory {
  HOURLY
  SALARIED
  VOLUNTEER
}

enum PayrollAdjustmentRevisionAction {
  CREATED
  UPDATED
  INCLUDED
  VOIDED
}

enum JobFunctionTimingAnchor {
  FIRST_MOVIE_START
  FIRST_MOVIE_END
  LAST_MOVIE_START
  LAST_MOVIE_END
  FIXED_TIME
}



enum PayrollMode {
  HOURS_ONLY
  SIMPLE
  ADVANCED
}

enum PayrollVersionStatus {
  SCHEDULED
  ACTIVE
  SUPERSEDED
  CANCELLED
}

enum PayRuleKind {
  TIME_WINDOW
  WEEKDAY
  WEEKEND
  HOLIDAY
  JOB_FUNCTION
}

enum PayRuleStackingMode {
  STACK
  EXCLUSIVE
}

enum PayCalculationType {
  FIXED_PER_HOUR
  PERCENT_OF_BASE
}

enum CinemaSpecialDayType {
  PUBLIC_HOLIDAY
  CUSTOM
}

enum PayrollConfigurationChangeType {
  PAYROLL_MODE
  PAY_RATE
  PAY_RULE
  SPECIAL_DAY
}

enum PayrollCalculationRunStatus {
  PREVIEW
  LOCKED
}

enum PayrollCalculationLineType {
  HOURS
  BASE_PAY
  SUPPLEMENT
  ADJUSTMENT
}

enum ShiftTimingSource {
  MANUAL
  JOB_FUNCTION_RULE
  TEMPLATE
  MIGRATED
}

enum ScheduleTemplateWeekParity {
  ANY
  EVEN
  ODD
}

model Cinema {
  id                                Int                           @id @default(autoincrement())
  name                              String
  logoUrl                           String?
  createdAt                         DateTime                      @default(now())
  allowShiftTradePool               Boolean                       @default(false)
  allowShiftTradeDirect             Boolean                       @default(false)
  payrollRulesEnabled               Boolean                       @default(false)
  clockInDeviationToleranceMinutes  Int                           @default(0)
  clockOutDeviationToleranceMinutes Int                           @default(0)
  requireNoteForClockInDeviation    Boolean                       @default(true)
  requireNoteForClockOutDeviation   Boolean                       @default(true)
  requireNoteForManualEntry         Boolean                       @default(true)
  automaticTimeRegistrationEnabled    Boolean                       @default(false)
  automaticTimeRegistrationMethod     String                        @default("PLANNED_SHIFT")
  automaticTimeRegistrationMinutes    Int                           @default(0)
  automaticTimeRegistrationActiveFrom DateTime?
  payrollOvertimeEnabled            Boolean                       @default(false)
  plannedOvertimeEnabled            Boolean                       @default(true)
  dailyOvertimeEnabled              Boolean                       @default(false)
  weeklyOvertimeEnabled             Boolean                       @default(false)
  dailyOvertimeThreshold            Float                         @default(8)
  weeklyOvertimeThreshold           Float                         @default(37)
  payrollPeriodModel                PayrollPeriodModel            @default(CALENDAR_MONTH)
  payrollPeriodStartDay             Int                           @default(1)
  payrollPeriodEndDay               Int                           @default(31)
  payrollPeriodAnchorDate           DateTime?
  payrollPayoutRule                 PayrollPayoutRule             @default(LAST_WEEKDAY_OF_MONTH)
  payrollPayoutDay                  Int                           @default(0)
  movieShowings                     MovieShowing[]
  leaveRequests                     LeaveRequest[]
  shiftTrades                       ShiftTrade[]
  defaultCinemaUsers                User[]                        @relation("UserDefaultCinema")
  userCinemaMemberships             UserCinemaMembership[]
  workTypes                         WorkType[]
  dayPeriods                        DayPeriod[]
  jobFunctions                      JobFunction[]
  jobFunctionTimingRules            JobFunctionTimingRule[]
  scheduleTemplates                 ScheduleTemplate[]
  monthPlanDays                     MonthPlanDay[]
  scheduleTemplateDays              ScheduleTemplateDay[]
  scheduleTemplateJobFunctions      ScheduleTemplateJobFunction[]
  scheduleTemplateAssignments       ScheduleTemplateAssignment[]
  userJobFunctions                  UserJobFunction[]
  shifts                            Shift[]
  messages                          Message[]
  timeEntries                       TimeEntry[]
  automaticTimeRegistrationVersions CinemaAutomaticTimeRegistrationVersion[]
  notifications                     Notification[]
  pushSubscriptions                 PushSubscription[]
  employeeDocuments                 EmployeeDocument[]
  auditLogs                         AuditLog[]
  payrollPeriods                    PayrollPeriod[]
  payrollTypes                      PayrollType[]
  payrollConfigurationVersions      CinemaPayrollConfigurationVersion[]
  payRules                          PayRule[]
  specialDays                       CinemaSpecialDay[]
  payrollConfigurationChanges       PayrollConfigurationChange[]
  payrollCalculationRuns            PayrollCalculationRun[]
  aiLearningEvents                  AiLearningEvent[]
  staffingRequests                  StaffingRequest[]
  payrollAdjustments                PayrollAdjustment[]
  aiEnabled                         Boolean                       @default(false)
  shiftPlanningDrafts               ShiftPlanningDraft[]
  shiftPlanningDraftItems           ShiftPlanningDraftItem[]
  shiftPlanningDraftDays            ShiftPlanningDraftDay[]
  moduleSettings                    CinemaModuleSetting[]
}



model CinemaAutomaticTimeRegistrationVersion {
  id        Int      @id @default(autoincrement())
  cinemaId  Int
  cinema    Cinema   @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  method    String
  minutes   Int      @default(0)
  validFrom DateTime
  validTo   DateTime?
  createdAt DateTime @default(now())

  @@index([cinemaId, validFrom, validTo])
  @@index([cinemaId, validTo])
}

model CinemaModuleSetting {
  id        Int      @id @default(autoincrement())
  cinemaId  Int
  cinema    Cinema   @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  moduleKey String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cinemaId, moduleKey])
  @@index([cinemaId, enabled])
}

model User {
  timeEntryRevisions                    TimeEntryRevision[]
  id                                    Int                                  @id @default(autoincrement())
  email                                 String                               @unique
  password                              String
  firstName                             String
  lastName                              String
  phone                                 String?
  profileImage                          String?
  address                               String?
  birthDate                             DateTime?
  emergencyPhone                        String?
  skills                                String?
  notes                                 String?
  theme                                 String                               @default("light")
  role                                  Role                                 @default(EMPLOYEE)
  createdAt                             DateTime                             @default(now())
  isActive                              Boolean                              @default(true)
  deactivatedAt                         DateTime?
  defaultCinemaId                       Int?
  defaultCinema                         Cinema?                              @relation("UserDefaultCinema", fields: [defaultCinemaId], references: [id], onDelete: SetNull)
  cinemaMemberships                     UserCinemaMembership[]
  shifts                                Shift[]
  leaveRequests                         LeaveRequest[]
  createdLeaveRequests                  LeaveRequest[]                       @relation("LeaveRequestCreatedBy")
  userJobFunctions                      UserJobFunction[]                    @relation("UserJobFunctionUser")
  assignedUserJobFunctions              UserJobFunction[]                    @relation("UserJobFunctionAssignedBy")
  scheduleTemplateAssignments           ScheduleTemplateAssignment[]
  offeredTrades                         ShiftTrade[]                         @relation("OfferedTrades")
  acceptedTrades                        ShiftTrade[]                         @relation("AcceptedTrades")
  rejectedTrades                        ShiftTrade[]                         @relation("RejectedTrades")
  targetedTrades                        ShiftTrade[]                         @relation("TargetedTrades")
  sentMessages                          Message[]                            @relation("SentMessages")
  receivedMessages                      Message[]                            @relation("ReceivedMessages")
  timeEntries                           TimeEntry[]
  pushSubscriptions                     PushSubscription[]
  documents                             EmployeeDocument[]
  notifications                         Notification[]
  auditLogs                             AuditLog[]
  requestedStaffingRequests             StaffingRequest[]                    @relation("RequestedStaffingRequests")
  targetedStaffingRequests              StaffingRequest[]                    @relation("TargetedStaffingRequests")
  payrollAdjustments                    PayrollAdjustment[]                  @relation("PayrollAdjustmentUser")
  createdPayrollAdjustments             PayrollAdjustment[]                  @relation("PayrollAdjustmentCreatedBy")
  payrollAdjustmentRevisions            PayrollAdjustmentRevision[]
  createdPayrollConfigurationChanges    PayrollConfigurationChange[]         @relation("PayrollConfigurationChangeCreatedBy")
  createdPayrollConfigurationVersions   CinemaPayrollConfigurationVersion[]  @relation("CinemaPayrollConfigurationVersionCreatedBy")
  createdMembershipPayRateVersions      MembershipPayRateVersion[]           @relation("MembershipPayRateVersionCreatedBy")
  createdPayRuleVersions                PayRuleVersion[]                     @relation("PayRuleVersionCreatedBy")
  cancelledPayRuleVersions              PayRuleVersion[]                     @relation("PayRuleVersionCancelledBy")
  createdSpecialDays                    CinemaSpecialDay[]                   @relation("CinemaSpecialDayCreatedBy")
  createdPayrollCalculationRuns         PayrollCalculationRun[]              @relation("PayrollCalculationRunCreatedBy")
  staffingAiProfile                     StaffingAiProfile?
  createdShiftPlanningDrafts            ShiftPlanningDraft[]                 @relation("ShiftPlanningDraftCreatedBy")
  shiftPlanningDraftItems               ShiftPlanningDraftItem[]

  @@index([defaultCinemaId])
}



model UserCinemaMembership {
  id                         Int                      @id @default(autoincrement())
  userId                     Int
  user                       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cinemaId                   Int
  cinema                     Cinema                   @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  role                       CinemaRole               @default(EMPLOYEE)
  isActive                   Boolean                  @default(true)
  deactivatedAt              DateTime?
  employmentType             EmploymentType           @default(HOURLY)
  hireDate                   DateTime?
  employeeNumber             String?
  payrollEmployeeId          String?
  canManageSchedule          Boolean                  @default(false)
  canManageUsers             Boolean                  @default(false)
  canManagePayroll           Boolean                  @default(false)
  canManageLeaveRequests     Boolean                  @default(false)
  canManageCinemaSettings    Boolean                  @default(false)
  canSendBroadcastMessages   Boolean                  @default(false)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  payRateVersions            MembershipPayRateVersion[]
  payrollCalculationLines    PayrollCalculationLine[]
  payrollConfigurationChanges PayrollConfigurationChange[]

  @@unique([userId, cinemaId])
  @@index([userId])
  @@index([cinemaId])
  @@index([isActive])
  @@index([cinemaId, isActive, role])
}


model WorkType {
  id               Int               @id @default(autoincrement())
  name             String
  color            String            @default("#2563eb")
  createdAt        DateTime          @default(now())
  isActive         Boolean           @default(true)
  archivedAt       DateTime?
  cinemaId         Int
  cinema           Cinema            @relation(fields: [cinemaId], references: [id])
  payrollTypeId    Int?
  payrollType      PayrollType?      @relation(fields: [payrollTypeId], references: [id])
  shifts           Shift[]
  staffingRequests StaffingRequest[]
  jobFunctions     JobFunction[]
}


model DayPeriod {
  id           Int           @id @default(autoincrement())
  cinemaId     Int
  cinema       Cinema        @relation(fields: [cinemaId], references: [id])
  name         String
  startMinute  Int
  endMinute    Int
  sortOrder    Int           @default(0)
  isActive     Boolean       @default(true)
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  jobFunctions JobFunction[]

  @@index([cinemaId])
  @@index([isActive])
  @@index([startMinute, endMinute])
}

model JobFunction {
  id                         Int                  @id @default(autoincrement())
  cinemaId                   Int
  cinema                     Cinema               @relation(fields: [cinemaId], references: [id])
  name                       String
  nameKey                    String
  description                String?
  color                      String               @default("#2563eb")
  sortOrder                  Int                  @default(0)
  dayPeriodId                Int?
  dayPeriod                  DayPeriod?           @relation(fields: [dayPeriodId], references: [id])
  workTypeId                 Int?
  workType                   WorkType?            @relation(fields: [workTypeId], references: [id], onDelete: SetNull)
  defaultPayrollExportCodeId Int?
  defaultPayrollExportCode   PayrollType?         @relation("JobFunctionDefaultPayrollExportCode", fields: [defaultPayrollExportCodeId], references: [id], onDelete: SetNull)
  isActive                   Boolean              @default(true)
  archivedAt                 DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @default(now()) @updatedAt

  userJobFunctions             UserJobFunction[]
  timingRule                   JobFunctionTimingRule?
  scheduleTemplateJobFunctions ScheduleTemplateJobFunction[]
  shiftPlanningDraftItems      ShiftPlanningDraftItem[]
  shifts                       Shift[]
  staffingRequests             StaffingRequest[]
  payRuleVersions              PayRuleVersion[]
  payrollCalculationLines      PayrollCalculationLine[]

  @@unique([cinemaId, nameKey])
  @@index([cinemaId])
  @@index([dayPeriodId])
  @@index([workTypeId])
  @@index([defaultPayrollExportCodeId])
  @@index([isActive])
}


model JobFunctionTimingRule {
  id                     Int                     @id @default(autoincrement())
  cinemaId               Int
  cinema                 Cinema                  @relation(fields: [cinemaId], references: [id])
  jobFunctionId          Int                     @unique
  jobFunction            JobFunction             @relation(fields: [jobFunctionId], references: [id], onDelete: Cascade)
  filmWindowStartMinute  Int                     @default(0)
  filmWindowEndMinute    Int                     @default(1440)
  startAnchor            JobFunctionTimingAnchor @default(FIRST_MOVIE_START)
  startOffsetMinutes     Int                     @default(0)
  startFixedMinute       Int?
  endAnchor              JobFunctionTimingAnchor @default(LAST_MOVIE_END)
  endOffsetMinutes       Int                     @default(0)
  endFixedMinute         Int?
  fallbackStartMinute    Int?
  fallbackEndMinute      Int?
  roundToQuarter         Boolean                 @default(false)
  roundStartToNearestQuarter Boolean                 @default(false)
  roundEndToNearestQuarter     Boolean                 @default(false)
  restrictMovieStartsToWindow Boolean                 @default(true)
  clampToDayPeriod       Boolean                 @default(true)
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @default(now()) @updatedAt

  @@index([cinemaId])
  @@index([jobFunctionId])
  @@index([isActive])
}


model UserJobFunction {
  id               Int         @id @default(autoincrement())
  cinemaId         Int
  cinema           Cinema      @relation(fields: [cinemaId], references: [id])
  userId           Int
  user             User        @relation("UserJobFunctionUser", fields: [userId], references: [id])
  jobFunctionId    Int
  jobFunction      JobFunction @relation(fields: [jobFunctionId], references: [id])
  assignedByUserId Int?
  assignedByUser   User?       @relation("UserJobFunctionAssignedBy", fields: [assignedByUserId], references: [id])
  createdAt        DateTime    @default(now())

  @@unique([userId, jobFunctionId])
  @@index([cinemaId])
  @@index([userId])
  @@index([jobFunctionId])
}

model ScheduleTemplate {
  id          Int                        @id @default(autoincrement())
  cinemaId    Int
  cinema      Cinema                     @relation(fields: [cinemaId], references: [id])
  name        String
  description String?
  weekParity  ScheduleTemplateWeekParity @default(ANY)
  startsOn    DateTime?
  sortOrder   Int                        @default(0)
  isActive    Boolean                    @default(true)
  archivedAt  DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @default(now()) @updatedAt

  days                    ScheduleTemplateDay[]
  monthPlanDays           MonthPlanDay[]
  shiftPlanningDrafts     ShiftPlanningDraft[]
  shiftPlanningDraftItems ShiftPlanningDraftItem[]
  shiftPlanningDraftDays  ShiftPlanningDraftDay[]

  @@index([cinemaId])
  @@index([isActive])
  @@index([weekParity])
}

model MonthPlanDay {
  id                      Int                      @id @default(autoincrement())
  cinemaId                Int
  cinema                  Cinema                   @relation(fields: [cinemaId], references: [id])
  date                    DateTime
  isActive                Boolean                  @default(true)
  scheduleTemplateId      Int?
  scheduleTemplate        ScheduleTemplate?        @relation(fields: [scheduleTemplateId], references: [id], onDelete: SetNull)
  note                    String?
  movieProgramFirstStart  DateTime?
  movieProgramLastEnd     DateTime?
  movieShowingCount       Int                      @default(0)
  plannedShiftCount       Int                      @default(0)
  unassignedShiftCount    Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @default(now()) @updatedAt
  shiftPlanningDraftItems ShiftPlanningDraftItem[]

  @@unique([cinemaId, date])
  @@index([cinemaId])
  @@index([date])
  @@index([scheduleTemplateId])
  @@index([isActive])
}

model ScheduleTemplateDay {
  id         Int              @id @default(autoincrement())
  cinemaId   Int
  cinema     Cinema           @relation(fields: [cinemaId], references: [id])
  templateId Int
  template   ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  weekday    Int
  isActive   Boolean          @default(true)
  note       String?
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @default(now()) @updatedAt

  jobFunctions            ScheduleTemplateJobFunction[]
  shiftPlanningDraftItems ShiftPlanningDraftItem[]

  @@unique([templateId, weekday])
  @@index([cinemaId])
  @@index([templateId])
  @@index([weekday])
  @@index([isActive])
}

model ScheduleTemplateJobFunction {
  id            Int                 @id @default(autoincrement())
  cinemaId      Int
  cinema        Cinema              @relation(fields: [cinemaId], references: [id])
  templateDayId Int
  templateDay   ScheduleTemplateDay @relation(fields: [templateDayId], references: [id], onDelete: Cascade)
  jobFunctionId Int
  jobFunction   JobFunction         @relation(fields: [jobFunctionId], references: [id])
  requiredCount Int                 @default(1)
  sortOrder     Int                 @default(0)
  note          String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt

  assignments             ScheduleTemplateAssignment[]
  shiftPlanningDraftItems ShiftPlanningDraftItem[]

  @@index([cinemaId])
  @@index([templateDayId])
  @@index([jobFunctionId])
}

model ScheduleTemplateAssignment {
  id                    Int                         @id @default(autoincrement())
  cinemaId              Int
  cinema                Cinema                      @relation(fields: [cinemaId], references: [id])
  templateJobFunctionId Int
  templateJobFunction   ScheduleTemplateJobFunction @relation(fields: [templateJobFunctionId], references: [id], onDelete: Cascade)
  userId                Int
  user                  User                        @relation(fields: [userId], references: [id])
  sortOrder             Int                         @default(0)
  createdAt             DateTime                    @default(now())

  @@unique([templateJobFunctionId, userId])
  @@index([cinemaId])
  @@index([templateJobFunctionId])
  @@index([userId])
}

model ShiftPlanningDraft {
  id                 Int                      @id @default(autoincrement())
  cinemaId           Int
  cinema             Cinema                   @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  year               Int
  month              Int
  status             String                   @default("DRAFT")
  source             String                   @default("MONTH_PLAN")
  note               String?
  warnings           Json?
  createdByUserId    Int?
  createdByUser      User?                    @relation("ShiftPlanningDraftCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @default(now()) @updatedAt
  items              ShiftPlanningDraftItem[]
  days               ShiftPlanningDraftDay[]
  scheduleTemplate   ScheduleTemplate?        @relation(fields: [scheduleTemplateId], references: [id])
  scheduleTemplateId Int?

  @@index([cinemaId])
  @@index([year, month])
  @@index([status])
  @@index([createdAt])
}

model ShiftPlanningDraftDay {
  id                 Int                @id @default(autoincrement())
  cinemaId           Int
  cinema             Cinema             @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  draftId            Int
  draft              ShiftPlanningDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  date               DateTime
  isActive           Boolean            @default(true)
  scheduleTemplateId Int?
  scheduleTemplate   ScheduleTemplate?  @relation(fields: [scheduleTemplateId], references: [id], onDelete: SetNull)
  note               String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt

  @@unique([draftId, date])
  @@index([cinemaId])
  @@index([draftId])
  @@index([date])
  @@index([scheduleTemplateId])
  @@index([isActive])
}
model ShiftPlanningDraftItem {
  id                    Int                          @id @default(autoincrement())
  cinemaId              Int
  cinema                Cinema                       @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  draftId               Int
  draft                 ShiftPlanningDraft           @relation(fields: [draftId], references: [id], onDelete: Cascade)
  date                  DateTime
  monthPlanDayId        Int?
  monthPlanDay          MonthPlanDay?                @relation(fields: [monthPlanDayId], references: [id], onDelete: SetNull)
  scheduleTemplateId    Int?
  scheduleTemplate      ScheduleTemplate?            @relation(fields: [scheduleTemplateId], references: [id], onDelete: SetNull)
  scheduleTemplateDayId Int?
  scheduleTemplateDay   ScheduleTemplateDay?         @relation(fields: [scheduleTemplateDayId], references: [id], onDelete: SetNull)
  templateJobFunctionId Int?
  templateJobFunction   ScheduleTemplateJobFunction? @relation(fields: [templateJobFunctionId], references: [id], onDelete: SetNull)
  jobFunctionId         Int?
  jobFunction           JobFunction?                 @relation(fields: [jobFunctionId], references: [id], onDelete: SetNull)
  userId                Int?
  user                  User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  requiredIndex         Int                          @default(1)
  status                String                       @default("DRAFT")
  plannedStartMinute    Int?
  plannedEndMinute      Int?
  startTime             DateTime?
  endTime               DateTime?
  warningCode           String?
  warningMessage        String?
  metadata              Json?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @default(now()) @updatedAt

  @@index([cinemaId])
  @@index([draftId])
  @@index([date])
  @@index([monthPlanDayId])
  @@index([scheduleTemplateId])
  @@index([scheduleTemplateDayId])
  @@index([templateJobFunctionId])
  @@index([jobFunctionId])
  @@index([userId])
  @@index([status])
}

model Shift {
  id                       Int               @id @default(autoincrement())
  startTime                DateTime
  endTime                  DateTime
  note                     String?
  createdAt                DateTime          @default(now())
  cinemaId                 Int
  cinema                   Cinema            @relation(fields: [cinemaId], references: [id])
  userId                   Int?
  user                     User?             @relation(fields: [userId], references: [id])
  workTypeId               Int?
  workType                 WorkType?         @relation(fields: [workTypeId], references: [id])
  jobFunctionId            Int
  jobFunction              JobFunction       @relation(fields: [jobFunctionId], references: [id])
  jobFunctionNameSnapshot  String
  jobFunctionColorSnapshot String
  timingSource             ShiftTimingSource @default(MANUAL)
  timingRuleSnapshot       Json?
  sourceMovieShowingIds    Int[]             @default([])
  trades                   ShiftTrade[]
  timeEntries              TimeEntry[]
  staffingRequests         StaffingRequest[]

  @@index([jobFunctionId])
  @@index([workTypeId])
  @@index([cinemaId, startTime, id])
  @@index([cinemaId, endTime, startTime, id])
  @@index([cinemaId, userId, startTime, endTime])
}


model MovieShowing {
  id        Int      @id @default(autoincrement())
  title     String
  hall      String
  startTime DateTime
  endTime   DateTime
  soldSeats Int      @default(0)
  freeSeats Int      @default(0)
  createdAt DateTime @default(now())
  cinemaId  Int
  cinema    Cinema   @relation(fields: [cinemaId], references: [id])

  @@index([cinemaId, startTime, id])
  @@index([cinemaId, endTime, startTime, id])
}

model LeaveRequest {
  id              Int         @id @default(autoincrement())
  startDate       DateTime
  endDate         DateTime
  reason          String?
  status          LeaveStatus @default(PENDING)
  createdAt       DateTime    @default(now())
  cinemaId        Int
  cinema          Cinema      @relation(fields: [cinemaId], references: [id])
  userId          Int
  user            User        @relation(fields: [userId], references: [id])
  createdByUserId Int
  createdByUser   User        @relation("LeaveRequestCreatedBy", fields: [createdByUserId], references: [id])

  @@index([cinemaId, userId, status, startDate, endDate])
  @@index([cinemaId, status, id])
  @@index([cinemaId, userId, status, id])
  @@index([cinemaId, status, startDate, endDate, id])
  @@index([status, startDate, id])
}

model ShiftTrade {
  id                        Int              @id @default(autoincrement())
  status                    ShiftTradeStatus @default(OPEN)
  message                   String?
  createdAt                 DateTime         @default(now())
  shiftId                   Int?
  shift                     Shift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  shiftStartTimeSnapshot    DateTime
  shiftEndTimeSnapshot      DateTime
  jobFunctionIdSnapshot     Int
  jobFunctionNameSnapshot   String
  jobFunctionColorSnapshot  String
  offeredByUserId           Int
