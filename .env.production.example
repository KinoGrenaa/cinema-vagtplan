# Copy to .env.production. Never commit the real file.
# The public browser origin and Caddy site normally use the same HTTPS domain.
APP_ORIGIN=https://vagtplan.example.dk
CADDY_SITE_ADDRESS=https://vagtplan.example.dk
CADDY_ACME_EMAIL=drift@example.dk

# Public listener bindings. Restrict these at the host firewall as appropriate.
HTTP_BIND=0.0.0.0:80
HTTPS_BIND=0.0.0.0:443
HTTPS_UDP_BIND=0.0.0.0:443

POSTGRES_USER=cinema
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
POSTGRES_DB=cinema_vagtplan
# Keep the password URL-safe, or percent-encode it in DATABASE_URL.
DATABASE_URL=postgresql://cinema:replace-with-a-long-random-alphanumeric-password@database:5432/cinema_vagtplan?schema=public

JWT_SECRET=replace-with-at-least-64-random-hex-characters

# Optional application integrations can be added below, for example VAPID keys.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:drift@example.dk
