# Copy this file to .env and fill in local values.
# Never commit .env files or real secrets.

POSTGRES_USER=cinema
POSTGRES_PASSWORD=replace-with-a-local-dev-password
POSTGRES_DB=cinema_vagtplan

# Frontend URL used by the browser to reach the backend API in local development.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Keep backend/.env DATABASE_URL aligned with the Postgres values above, for example:
# DATABASE_URL=postgresql://cinema:replace-with-a-local-dev-password@database:5432/cinema_vagtplan?schema=public
